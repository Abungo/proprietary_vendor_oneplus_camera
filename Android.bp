android_app_import {
    name: "OnePlusCamera",
    owner: "oneplus",
    apk: "OnePlusCamera.apk",
    presigned: true,
    privileged: true,
    system_ext_specific: true,
    dex_preopt: {
        enabled: false,
    },
    overrides: [
        "Snap",
        "Camera2",
    ],
}

android_app_import {
    name: "OnePlusCameraService",
    owner: "oneplus",
    apk: "OnePlusCameraService.apk",
    certificate: "platform",
    privileged: true,
    dex_preopt: {
        enabled: false,
    },
}

android_app_import {
    name: "OnePlusGallery",
    owner: "oneplus",
    apk: "OnePlusGallery.apk",
    presigned: true,
    privileged: true,
    system_ext_specific: true,
    dex_preopt: {
        enabled: false,
    },
}
